# Ollama server settings for the 32 GB RTX 5090. Every value can be overridden from the environment
# (the Vast image sources this file). Usage: set -a; source deploy/ollama/ollama.env; set +a; ollama serve
#
# 2 resident models (deepseek-r1:32b + qwen2.5:7b). Raise to 3 only if you also pull the vision model
# AND set OLLAMA_NUM_PARALLEL=1 (three models + 2 slots of KV cache do not fit in 32 GB).
OLLAMA_MAX_LOADED_MODELS=${OLLAMA_MAX_LOADED_MODELS:-2}
# Analysts run in parallel; 2 lets the fast tier serve two at once. Each extra slot costs KV cache on EVERY model.
OLLAMA_NUM_PARALLEL=${OLLAMA_NUM_PARALLEL:-2}
OLLAMA_KEEP_ALIVE=${OLLAMA_KEEP_ALIVE:--1}
OLLAMA_FLASH_ATTENTION=${OLLAMA_FLASH_ATTENTION:-1}
OLLAMA_KV_CACHE_TYPE=${OLLAMA_KV_CACHE_TYPE:-q8_0}
# Default context (2-4k) silently truncates analyst reports; the /v1 endpoint cannot set it per request.
OLLAMA_CONTEXT_LENGTH=${OLLAMA_CONTEXT_LENGTH:-8192}

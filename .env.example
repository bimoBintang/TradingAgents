# ── TradingAgents Environment Configuration ──────────────────────────
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql://tradingagents:changeme@localhost:5432/tradingagents

# SQLite (local development):
# DATABASE_URL=sqlite:///./tradingagents.db

# Turso (cloud SQLite):
# DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# ── Authentication (Clerk) ────────────────────────────────────────────
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json

# ── LLM API Keys ─────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=AI...

# ── Broker Credentials (optional) ────────────────────────────────────
# CCXT (crypto):
# CCXT_API_KEY=your_key
# CCXT_API_SECRET=your_secret
# CCXT_EXCHANGE=bybit

# Alpaca (stocks):
# ALPACA_API_KEY=your_key
# ALPACA_SECRET_KEY=your_secret
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Background Tasks (Celery) ─────────────────────────────────────────
# Required for production. If not set, falls back to threading (local dev).
# CELERY_BROKER_URL=redis://localhost:6379/0

# ── Execution Config ─────────────────────────────────────────────────
EXECUTION_MODE=paper
# EXECUTION_BROKER=paper

# Copy to .env and fill in. Never commit the real .env.

# ── Required ──────────────────────────────────────────────────────────

# SQLite for local dev; PostgreSQL or Turso in production.
#   sqlite:///./tradingagents.db
#   postgresql://user:pass@host/dbname
#   libsql://your-db.turso.io          (also set TURSO_AUTH_TOKEN)
DATABASE_URL=sqlite:///./tradingagents.db

# Encrypts exchange API credentials at rest. REQUIRED in production —
# api/crypto.py refuses to start without it when ENVIRONMENT=production.
#
# Without it the process generates a throwaway key, which fails in a way
# that is quiet rather than loud: within one process run everything works,
# so a user can save credentials and trade live successfully. After the
# next restart those credentials no longer decrypt, the account silently
# falls back to paper, and nothing tells the user their live bot stopped
# being live.
#
# Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Rotation: put the new key FIRST, keep the old one after it, comma-separated.
# MultiFernet encrypts with the first and decrypts with any of them.
#   FERNET_KEY=<new>,<old>
FERNET_KEY=

# Set to "production" on any deployment handling real money. This is what
# turns a missing FERNET_KEY from a warning into a refusal to start.
ENVIRONMENT=development

# ── Auth (Clerk) ──────────────────────────────────────────────────────

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=

# ── LLM providers ─────────────────────────────────────────────────────
# Only the provider selected in Settings > AI Language Models is needed.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Rate limits ───────────────────────────────────────────────────────
# Keyed per authenticated account (falling back to IP). Tighten these on a
# shared or demo instance.
#
# Each /api/analyze call runs the full agent graph — 20+ LLM requests,
# several on the most expensive configured model. This limit is a billing
# control, not a load control.
ANALYZE_RATE_LIMIT=10/hour

# /api/config/test-broker sends credentials to a live exchange. Exchanges
# rate-limit and then IP-ban, which takes trading offline for every account
# on the host, not just the caller.
BROKER_TEST_RATE_LIMIT=10/minute

# ── Optional ──────────────────────────────────────────────────────────

TURSO_AUTH_TOKEN=
REDIS_URL=
CELERY_BROKER_URL=
FINNHUB_API_KEY=
